# AWS AI Discovery Agent - Environment Configuration Example
# Copy this file to .env and configure as needed.
# NEVER commit real credentials to source control.

# Execution Mode: 'mock' (default offline demo) or 'aws' (real AWS account scan)
DISCOVERY_MODE=aws

# AWS Credential Configuration (Used only when DISCOVERY_MODE=aws)
# Option 1: Direct Access Keys (Recommended for quick setup without AWS CLI)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: Session token if using temporary credentials (AWS SSO / AWS Academy / Learner Lab)
# AWS_SESSION_TOKEN=

# AWS Default Region
AWS_DEFAULT_REGION=us-east-1

# Option 2: AWS CLI Named Profile (Uncomment if using ~/.aws/credentials)
# AWS_PROFILE=default

# Optional IAM Role to Assume (if cross-account / role delegation is used)
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/ReadOnlyAIDiscoveryRole
# AWS_ROLE_SESSION_NAME=AIDiscoverySession

# Region Configuration
# Comma-separated list of regions to scan. If empty, enabled regions will be detected automatically.
SCAN_REGIONS=us-east-1,us-west-2,ap-south-1

# Regions to strictly exclude from scanning
SCAN_DENYLIST_REGIONS=

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///ai_discovery.db

# Module Toggles (true/false)
MODULE_BEDROCK=true
MODULE_SAGEMAKER=true
MODULE_MANAGED_AI=true
MODULE_INFRASTRUCTURE=true
MODULE_INTEGRATIONS=true
MODULE_RESOURCE_EXPLORER=true
MODULE_ACTIVITY=true

# Activity & CloudTrail Query Window (in days, max 90 for CloudTrail event history)
ACTIVITY_LOOKBACK_DAYS=30

# Logging
LOG_LEVEL=INFO
